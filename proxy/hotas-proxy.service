[Unit]
Description=HOTAS Bridge – USB proxy (controller MITM -> Xbox, proxy mode)
After=hotas-receiver.service network-online.target
Requires=hotas-receiver.service

[Service]
Type=simple
WorkingDirectory=/opt/hotas-bridge/proxy/usb-proxy
ExecStartPre=/sbin/modprobe raw_gadget
ExecStart=/opt/hotas-bridge/proxy/run_proxy.sh
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
